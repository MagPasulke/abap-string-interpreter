{
  "input_folder": "src",
  "input_filter": [],
  "exclude_filter": [
    "zbp_",
    "\\.smbc\\.json$"
  ],
  "output_folder": "output",
  "libs": [
    { "url": "https://github.com/open-abap/open-abap-core" },
    { "url": "https://github.com/open-abap/express-icf-shim" },
    { "url": "https://github.com/open-abap/open-abap-rap" },
    { "url": "https://github.com/open-abap/open-abap-sadl"}
  ],
  "write_unit_tests": true,
  "write_source_map": true,
  "options": {
    "setup": {
      "filename": "../__test/unit/setup.mjs",
      "preFunction": "initDatabase"
    },
    "ignoreSyntaxCheck": false,
    "addFilenames": true,
    "addCommonJS": true,
    "unknownTypes": "compileError"
  }
}
