# SAP ADT Connection (used by the ADT plugin in .opencode/plugins/adt/)
# The host must match the SAP system's TLS certificate (e.g. https://A4H.wdf.sap.corp:50001 for the trial)
SAP_ADT_URL=https://your-sap-system:44300
SAP_ADT_USER=DEVELOPER
SAP_ADT_PASSWORD=your-password-here

# Optional: PEM file with the CA certificate of the SAP system, if it is not
# trusted by Node.js (e.g. SAP Global Root CA for the ABAP Cloud Developer Trial)
# SAP_ADT_CA_FILE=/path/to/sap-global-root-ca.pem

# Default package for adt_rununit (used when no target object is specified)
SAP_ROOT_PACKAGE=$ZASIS
