### Bulk - missing id at position 2 (expect 400 ZASIS_MSGS/022)
POST {{baseUrl}}/ruleSetExecution/{{ruleSetId}}/bulk{{queryParams}}
Authorization: {{auth}}
Content-Type: application/json
Accept: application/json

{
  "items": [
    { "id": "a", "string_to_be_interpreted": "<Start><A7X>MatA<End>" },
    { "string_to_be_interpreted": "<Start><A7X>MatB<End>" }
  ]
}

### Bulk - empty id (expect 400 ZASIS_MSGS/022)
POST {{baseUrl}}/ruleSetExecution/{{ruleSetId}}/bulk{{queryParams}}
Authorization: {{auth}}
Content-Type: application/json
Accept: application/json

{
  "items": [
    { "id": "", "string_to_be_interpreted": "<Start><A7X>MatA<End>" }
  ]
}

### Bulk - duplicate id (expect 400 ZASIS_MSGS/023 naming dup-1)
POST {{baseUrl}}/ruleSetExecution/{{ruleSetId}}/bulk{{queryParams}}
Authorization: {{auth}}
Content-Type: application/json
Accept: application/json

{
  "items": [
    { "id": "a", "string_to_be_interpreted": "<Start><A7X>MatA<End>" },
    { "id": "dup-1", "string_to_be_interpreted": "<Start><A7X>MatB<End>" },
    { "id": "dup-1", "string_to_be_interpreted": "<Start><A7X>MatC<End>" },
    { "id": "a", "string_to_be_interpreted": "<Start><A7X>MatD<End>" }
  ]
}

### Bulk - mixed ok/error items (expect 200, item b error ZASIS_MSGS/015)
POST {{baseUrl}}/ruleSetExecution/{{ruleSetId}}/bulk{{queryParams}}
Authorization: {{auth}}
Content-Type: application/json
Accept: application/json

{
  "items": [
    { "id": "a", "string_to_be_interpreted": "<Start><A7X>MatA<End>" },
    { "id": "b", "string_to_be_interpreted": "" },
    { "id": "c", "string_to_be_interpreted": "<Start><A7X>MatC<End>" }
  ]
}

### Bulk - stopOnFirstError (expect 200, c and d skippedOnPrevError)
POST {{baseUrl}}/ruleSetExecution/{{ruleSetId}}/bulk{{queryParams}}
Authorization: {{auth}}
Content-Type: application/json
Accept: application/json

{
  "items": [
    { "id": "a", "string_to_be_interpreted": "<Start><A7X>MatA<End>" },
    { "id": "b", "string_to_be_interpreted": "" },
    { "id": "c", "string_to_be_interpreted": "<Start><A7X>MatC<End>" },
    { "id": "d", "string_to_be_interpreted": "" }
  ],
  "options": { "stopOnFirstError": true }
}

# ─────────────────────────────────────────────
# Unsupported HTTP methods
# ─────────────────────────────────────────────

### PUT (expect 405 ZASIS_MSGS/016)
PUT {{baseUrl}}/ruleSetExecution/{{ruleSetId}}{{queryParams}}
Authorization: {{auth}}
Content-Type: application/json
Accept: application/json

{
  "string_to_be_interpreted": "test"
}

### DELETE (expect 405 ZASIS_MSGS/016)
DELETE {{baseUrl}}/ruleSetExecution/{{ruleSetId}}{{queryParams}}
Authorization: {{auth}}
Accept: application/json

# ─────────────────────────────────────────────
# Invalid routes
# ─────────────────────────────────────────────

### GET invalid route (expect 400 ZASIS_MSGS/005)
GET {{baseUrl}}/invalidRoute{{queryParams}}
Authorization: {{auth}}
Accept: application/json

# ─────────────────────────────────────────────
# Auth tests (SAP only — local-icf has no auth)
# ─────────────────────────────────────────────

### GET RuleSet without auth (expect 401/403 on SAP, 200 on local-icf)
GET {{baseUrl}}/ruleSet/{{ruleSetId}}{{queryParams}}
Accept: application/json

### POST bulk without auth (expect 401/403 on SAP, 200 on local-icf)
POST {{baseUrl}}/ruleSetExecution/{{ruleSetId}}/bulk{{queryParams}}
Content-Type: application/json
Accept: application/json

{
  "items": [
    { "id": "a", "string_to_be_interpreted": "test" }
  ]
}
